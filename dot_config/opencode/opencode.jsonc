{
  "$schema": "https://opencode.ai/config.json",
  "model": "aperture-openai-compatible/glm-5.3-flash",
  "lsp": true,
  "enabled_providers": [
    "aperture-openai-compatible"
  ],
  "provider": {
    "aperture-openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aperture",
      "options": {
        "baseURL": "https://ai.beaver-cloud.ts.net/v1",
        "apiKey": "not-required"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "tool_call": true
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "tool_call": true
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "tool_call": true
        },
        "google/gemma4-e4b": {
          "name": "google/gemma4-e4b",
          "tool_call": true
        },
        "gpt-oss:120b": {
          "name": "gpt-oss:120b",
          "tool_call": true
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "tool_call": true
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen/qwen3.8-27b",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "aperture": {
      "type": "remote",
      "url": "https://ai.beaver-cloud.ts.net/v1/mcp"
    }
  }
}
