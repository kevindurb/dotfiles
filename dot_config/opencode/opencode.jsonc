{
  "$schema": "https://opencode.ai/config.json",
  "model": "aperture-openai-compatible/deepseek-v4.1-flash",
  "lsp": true,
  "enabled_providers": [
    "aperture-openai-compatible"
  ],
  "provider": {
    "aperture-openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aperture",
      "options": {
        "baseURL": "https://ai.beaver-cloud.ts.net/v1",
        "apiKey": "not-required"
      },
      "models": {
        "minimax-m3.1-flash-free": {
          "name": "minimax-m3.1-flash-free",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "minimax-m3.1-flash": {
          "name": "minimax-m3.1-flash",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "gpt-oss:120b": {
          "name": "gpt-oss:120b",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "kimi-k2.7-code": {
          "name": "kimi-k2.7-code",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen/qwen3.8-27b",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "aperture": {
      "type": "remote",
      "url": "https://ai.beaver-cloud.ts.net/v1/mcp"
    }
  }
}
