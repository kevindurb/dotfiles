{
  "$schema": "https://opencode.ai/config.json",
  "model": "aperture-openai-compatible/inkling-2-small",
  "lsp": true,
  "providers": {
    "aperture-openai-compatible": {
      "name": "Aperture",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.beaver-cloud.ts.net/v1",
        "apiKey": "not-required"
      },
      // Generated by ~/.local/bin/aperture-models at `chezmoi apply` time.
      // Do not edit: run `aperture-models --refresh && chezmoi apply`.
      "models":{{ output "sh" (joinPath .chezmoi.sourceDir "dot_local/bin/executable_aperture-models") | fromJson | toPrettyJson | trim | nindent 8 }}
    },
    "ollama": {
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "aperture": {
      "type": "remote",
      "url": "https://ai.beaver-cloud.ts.net/v1/mcp"
    }
  }
}
