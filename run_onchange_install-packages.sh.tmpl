{{- $os := .chezmoi.os -}}
{{- if or (eq $os "darwin") (eq $os "linux") -}}
{{- $common := index .packages "common" | default dict -}}
{{- $osPkgs := index .packages $os | default dict -}}
{{- $brew := concat (index $common "brew" | default (list)) (index $osPkgs "brew" | default (list)) -}}
{{- $cask := concat (index $common "cask" | default (list)) (index $osPkgs "cask" | default (list)) -}}
{{- $npm := concat (index $common "npm" | default (list)) (index $osPkgs "npm" | default (list)) -}}
{{- $uv := concat (index $common "uv" | default (list)) (index $osPkgs "uv" | default (list)) -}}
{{- $flatpak := index $osPkgs "flatpak" | default (list) -}}
#!/usr/bin/env bash
#
# Install the packages declared in .chezmoidata/packages.yaml.
#
# chezmoi re-runs this script whenever the package list changes.

set -eu

# Homebrew is not necessarily on PATH when chezmoi runs this script.
if ! command -v brew >/dev/null 2>&1; then
    for dir in "${HOME}/.linuxbrew/bin" /home/linuxbrew/.linuxbrew/bin /opt/homebrew/bin /usr/local/bin; do
        if [ -x "${dir}/brew" ]; then
            PATH="${dir}:${PATH}"
            export PATH
            break
        fi
    done
fi

if command -v brew >/dev/null 2>&1; then
    export HOMEBREW_BUNDLE_NO_UPGRADE=1
    export HOMEBREW_NO_ENV_HINTS=1
    export HOMEBREW_CASK_OPTS="--appdir=${HOME}/Applications"

    brew bundle --file=/dev/stdin <<'BREWFILE'
# vim: set ft=ruby:
cask_args appdir: "~/Applications", require_sha: true
ENV["PATH"] = "#{HOMEBREW_PREFIX}/bin:#{ENV["PATH"]}"
{{ range $brew }}brew {{ . | quote }}
{{ end }}{{ range $cask }}cask {{ . | quote }}
{{ end }}{{ range $npm }}npm {{ . | quote }}
{{ end }}{{ range $uv }}uv {{ . | quote }}
{{ end }}BREWFILE
else
    echo "brew not found, skipping Homebrew packages" >&2
fi
{{ if $flatpak }}
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    failed=""
    for app in {{ range $flatpak }}{{ . | quote }} {{ end }}; do
        flatpak install --user --assumeyes --noninteractive flathub "${app}" || failed="${failed} ${app}"
    done
    if [ -n "${failed}" ]; then
        echo "failed to install Flatpak packages:${failed}" >&2
        exit 1
    fi
else
    echo "flatpak not found, skipping Flatpak packages" >&2
fi
{{ end }}
{{- end -}}
